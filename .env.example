# Recommended: keep the DeepSeek key only on the backend.
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=120

# Laya decision layer
LAYA_ENABLED=1
LAYA_PRELOAD=0
LAYA_CONFIDENCE_THRESHOLD=0.78

# Origin is scheme + host only; GitHub Pages path is not part of Origin.
ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,https://vietflexmap.github.io
